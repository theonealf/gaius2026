    <title>Stockholm Förr - Historiska Bilder & Almanackor | GAIVS</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Följ med på en fascinerande resa genom Stockholms förlorade miljöer! Stockholmsalmanackan 2026, historiska posters, vykort och bok. Se hur Slussen, Södermalm, Kungsholmen har förändrats genom decennierna.">
    <meta name="keywords" content="Stockholmsalmanacka, Stockholm förr, historiska bilder Stockholm, gamla foton Stockholm, Stockholmsposters, vykort Stockholm, Stockholmsbild bok, förlorade miljöer Stockholm, stadsutveckling Stockholm, Slussen, Södermalm, Kungsholmen, Vasastan, GAIVS">
    <meta name="author" content="GAIVS">
    <meta name="robots" content="index, follow">
    <meta name="language" content="Swedish">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Stockholm Förr - Historiska Bilder & Almanackor | GAIVS">
    <meta property="og:description" content="Följ med på en fascinerande resa genom Stockholms förlorade miljöer! Stockholmsalmanackan 2026, historiska posters, vykort och bok. Se hur Slussen, Södermalm, Kungsholmen har förändrats.">
    <meta property="og:type" content="website">
