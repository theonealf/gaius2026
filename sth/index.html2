    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">

    <!-- GAIUS CSS -->
    <link rel="stylesheet" href="gaius.css">

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "GAIVS",
        "description": "Historiska bilder och almanackor från Stockholm",
        "url": "https://gaius.se",
        "logo": "https://gaius.se/gaius-logo.png",
        "sameAs": [],
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Stockholm Förr Produkter",
            "itemListElement": [
                {
                    "@type": "Product",
                    "name": "Stockholmsalmanackan 2026",
                    "description": "Följ med på en fascinerande reja genom Stockholms förlorade miljöer! Varje månad visar en historisk vy från ett svunnet Stockholm, tillsammans med en jämförelsebild från samma plats idag.",
                    "image": "https://gaius.se/wpAdmin/wp-content/uploads/2025/06/STHLM_ALM_2026.png",
                    "offers": {
                        "@type": "Offer",
                        "price": "249",
                        "priceCurrency": "SEK",
                        "availability": "https://schema.org/InStock"
                    }
                },
                {
                    "@type": "Product",
                    "name": "Stockholmsvykort - 20 olika motiv",
                    "description": "Ta del av ett svunnet Stockholm genom 20 vackra, löstagbara vykort baserade på autentiska tidstypiska vykort från början av 1900-talet.",
                    "offers": {
                        "@type": "Offer",
                        "price": "179",
                        "priceCurrency": "SEK",
                        "availability": "https://schema.org/InStock"
                    }
                },
                {
                    "@type": "Product",
                    "name": "Stockholmsposters - 4 olika motiv",
                    "description": "Upptäck våra vackra posters med autentiska fotografier från ett svunnet Stockholm. Varje motiv fångar stadens själ, från gator som inte längre finns kvar till ikoniska platser i sin forna glans.",
                    "offers": {
                        "@type": "Offer",
                        "price": "199",
                        "priceCurrency": "SEK",
                        "availability": "https://schema.org/InStock"
                    }
                },
                {
                    "@type": "Product",
                    "name": "Stockholmsbilder",
                    "description": "Stockholmsalmanackans 20-åriga tidsresa genom ett svunnet Stockholm. En komplett bok med alla bilder och texter från tidigare almanackor, nu utan kalenderdelen.",
                    "offers": {
                        "@type": "Offer",
                        "price": "179",
                        "priceCurrency": "SEK",
                        "availability": "https://schema.org/InStock"
                    }
                }
            ]
        }
    }
    </script>
</head>
<body>

    <!-- Navigation -->
    

    <!-- Hero Header -->
    <header class="hero stockholm" role="banner" aria-label="Huvudbild från historiska Stockholm">
        <nav id="mainNav" class="navbar navbar-dark transparent-nav" role="navigation" aria-label="Huvudnavigation">
  <div class="container d-flex justify-content-between align-items-center">
    <a class="navbar-brand2" href="https://gaius.se" aria-label="GAIVS - Hem" title="GAIUS - Hem">
      <img src="gaius-logo.png" alt="GAIVS logotyp - Stockholm Förr">
    </a>

    <div class="d-flex align-items-center gap-3">
      <!-- Varukorg -->
      <a href="https://gaius.se/wpAdmin/varukorg/" class="cart-link" aria-label="Varukorg" title="Gå till varukorg">
        <i class="bi bi-cart3" style="font-size: 1.5rem; color: white;"></i>
      </a>

      <!-- Hamburgarknapp -->
      <div class="menu-wrapper position-relative">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive"
          aria-controls="navbarResponsive" aria-expanded="false" aria-label="Visa navigationsmeny" title="Meny">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Meny -->
        <div class="collapse navbar-collapse position-absolute end-0 mt-2" id="navbarResponsive">
          <ul class="navbar-nav" role="menubar">
            <li class="nav-item" role="none"><a class="nav-link" href="https://stockholmforr.se/" role="menuitem">Stockholm</a></li>
                <li class="nav-item" role="none"><a class="nav-link" href="https://goteborgforr.se/" role="menuitem">Göteborg</a></li>
                <!-- <li class="nav-item" role="none"><a class="nav-link" href="#" role="menuitem">Om Oss</a></li>
                <li class="nav-item" role="none"><a class="nav-link" href="#" role="menuitem">Kontakt</a></li> -->
          </ul>
        </div>
      </div>
    </div>
  </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main">
        <!-- Intro Section -->
        <section class="py-5" aria-labelledby="main-heading">
            <div class="container text-center">
                <h1 id="main-heading" class="display-4">Stockholm Förr</h1>
                <p class="lead text-muted">Förlorade miljöer från Stockholm - En fascinerande resa genom stadens historia</p>
            </div>
        </section>

        <!-- Product Showcase -->
        <section class="product-showcase pb-5" aria-labelledby="products-heading">
            <div class="container">
                <h2 id="products-heading" class="sr-only">Våra Produkter</h2>

                <!-- Produkt 1: Almanackan -->
                <article class="product-card6 bg-pattern-1 mb-5" itemscope itemtype="https://schema.org/Product">
                    <div class="row g-0 align-items-center">
                        <div class="col-lg-6 order-lg-2 pt-3 prodposs">
                            <img src="https://gaius.se/wpAdmin/wp-content/uploads/2025/06/STHLM_ALM_2026.png" 
                                 alt="Stockholmsalmanackan 2026 - Historisk almanacka med jämförelser mellan gamla och nya Stockholm" 
                                 class="img-fluid" 
                                 itemprop="image">
                        </div>
                        <div class="col-lg-6">
                            <div class="product-content prod-bg-text-color1 text-center  text-lg-start">
                                <a href="https://gaius.se/wpAdmin/produkt/stockholmsalmanackan-2026/" 
                                   class="btn-buy mb-2" 
                                   itemprop="url"
                                   aria-label="Köp Stockholmsalmanackan 2026">Köp</a>
                                <p class="price mb-1" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="price">249</span> <span itemprop="priceCurrency" content="SEK">kr</span>
                                </p>                                
                                <p class="published-since">Publicerad sedan 2001</p>
                                <h2 class="product-title" itemprop="name">Stockholmsalmanackan 2026</h2>
                                <p class="product-description" itemprop="description">Följ med på en fascinerande reja genom Stockholms förlorade miljöer! Se hur Slussen, Södermalm, Kungsholmen, Vasastan och andra stadsdelar har förändrats genom decennierna.</p>
                            </div>
                        </div>                        
                    </div>
                </article>

                <!-- Produkt 2: Vykort -->
                <article class="product-card8 bg-pattern-2 mb-5" itemscope itemtype="https://schema.org/Product">
                    <div class="row g-0 align-items-center">
                        <div class="col-lg-6 order-lg-2 prodposs">
                           <img src="https://dev.frontdata.se/gaius/start4/img/STHLM_Prod_bild3_vykort.png" 
                                alt="Stockholmsvykort med 20 olika historiska motiv från Stockholms arkiv" 
                                class="img-fluid"
                                itemprop="image">
                        </div>
                        <div class="col-lg-6">
                             <div class="product-content prod-bg-text-color2 text-center text-lg-start">
                                <a href="https://gaius.se/wpAdmin/produkt/vykortsbok-stockholm-2023/" 
                                   class="btn-buy mb-2"
                                   itemprop="url"
                                   aria-label="Köp Stockholmsvykort">Köp</a>
                                <p class="price mb-1" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="price">179</span> <span itemprop="priceCurrency" content="SEK">kr</span>
                                </p>                                
                                <h2 class="product-title" itemprop="name">Stockholmsvykort <br>- 20 olika motiv</h2>
                                <p class="product-description" itemprop="description">Ta del av ett svunnet Stockholm genom 20 vackra, löstagbara vykort baserade på autentiska tidstypiska vykort från början av 1900-talet. Upptäck försvunna kvarter, klassiska fasader och vardagsliv från en annan tid.</p>
                            
                                <div class="d-flex align-items-center mt-5">
                                    <a href="https://gaius.se/wpAdmin/produkt/erbjudande-stockholmsalmanackan-2026-vykortsbok-kopia/"
                                        class="btn-buy mb-2" itemprop="url" aria-label="Köp Stockholmsvykort">Köp med rabatt
                                    </a>
                                    <div class="testblock ms-3">
                                        <!-- <div class="discount-icon-red" style="float: inline-start; font-size: 3rem; padding-bottom: 1.5rem;">!</div> -->
                                        <span class="kopmedrabatt"><b>48 kr rabatt</b> vid samtidig beställning <br> av Stockholmsalmanackan.</span>
                                    </div>
                                </div>
                                <p class="price mb-1" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="price">360</span> <span itemprop="priceCurrency"
                                        content="SEK">kr</span>
                                </p>
                            </div>
                              
                        </div>
                    </div>
                </article>

                <!-- Produkt 3: Posters -->
                <article class="product-card7 bg-pattern-1 mb-5" itemscope itemtype="https://schema.org/Product">
                    <div class="row g-0 align-items-center">
                        <div class="col-lg-6 order-lg-2 prodposs">
                            <img src="img/STHLM_Prod_bild2_poster.png" 
                                 alt="Stockholmsposters med 4 olika historiska motiv - Norra Hamgatan, Sprängkullsgatan, Stigbergstorget och Rosenlundsbron" 
                                 class="img-fluid"
                                 itemprop="image">
                        </div>
                        <div class="col-lg-6">
                            <div class="product-content prod-bg-text-color3 text-center text-lg-start">
                                <a href="https://gaius.se/wpAdmin/produkt/tavlor-med-stockholmsmotiv/" 
                                   class="btn-buy mb-2"
                                   itemprop="url"
                                   aria-label="Köp Stockholmsposters">Köp</a>
                                <p class="price mb-1" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="price">199</span> <span itemprop="priceCurrency" content="SEK">kr</span>
                                </p>
                                <h2 class="product-title" itemprop="name">Stockholmsposters <br>4 olika motiv</h2>
                                <div class="product-description" itemprop="description">
                                    <p>Upptäck våra vackra posters med autentiska fotografier från ett svunnet Stockholm. Varje motiv fångar stadens själ, tryckta i hög kvalitet och perfekt anpassade för inramning i A3-format.</p>
                                </div>
                                <div class="product-details">
                                    <p>#1 Katarinahissen (Söder) <br>
                                        #2 Riddarhustorget (Galma Stan)<br>
                                        #3 Jutas backe (Östermalm)<br>
                                        #4 Västra Slussgatan (Slussen)</p>
                                </div>
                                <div class="d-flex align-items-center mt-5">
                                    <a href="https://gaius.se/wpAdmin/produkt/erbjudande-stockholmsposter-stockholmsalmanackan-2026/"
                                        class="btn-buy mb-2" itemprop="url" aria-label="Köp Stockholmsposters">Köp med rabatt
                                    </a>
                                    <div class="testblock ms-3">
                                        <!-- <div class="discount-icon-red" style="float: inline-start; font-size: 3rem; padding-bottom: 1.5rem;">!</div> -->
                                        <span class="kopmedrabatt"><b>60 kr rabatt</b> vid samtidig beställning <br> av Stockholmsalmanackan.</span>
                                    </div>
                                </div>
                                <p class="price mb-1" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="price">388</span> <span itemprop="priceCurrency"
                                        content="SEK">kr</span>
                                </p>
                            </div>
                        </div>                        
                    </div>
                </article>
            </div>
        </section>
    </main>
    
    <!-- Footer -->
    <footer class="py-4">
        <div class="container">
            <p class="m-0 text-center text-muted">&copy; 2025 GAIVS. Alla rättigheter förbehållna.</p>
        </div>
    </footer>


